# MODE: pairing / qr-terminal / qr-image
MODE=pairing

# AUTH
AUTH_FOLDER=.auth_info
QR_PATH=./qr.png
QR_REFRESH_INTERVAL=120000

# PREFIX: multi bisa .,#,! atau . aja
# untuk tanpa prefix: kosongin atau isi false / none / 0
PREFIXES=".,#,!"

# BOT BOLEH RESPON PESAN DIRI SENDIRI? true / false
SELF_RESPONSE=true

# CASE INSENSITIVE true / false
CASE_INSENSITIVE=true