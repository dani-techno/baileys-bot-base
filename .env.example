# ============================================
# BAILEYS-BOT-BASE Environment Configuration
# ============================================

# Bot Connection Mode
# Options: pairing | qr-terminal | qr-image
# pairing      = Minimal pairing code approach (recommended)
# qr-terminal  = Display QR in terminal
# qr-image     = Save QR as PNG file
MODE=pairing

# Authentication Storage
# Where to store WhatsApp session credentials
AUTH_FOLDER=.auth_info

# QR Code Output (for qr-image mode)
QR_PATH=./qr.png

# QR Refresh Interval (milliseconds)
# How often to regenerate QR code if connection is pending
QR_REFRESH_INTERVAL=120000

# Command Prefixes
# Options:
#   ".,#,!"           = Multiple prefixes (. or # or !)
#   "."               = Single prefix
#   "false/none/0"    = No prefix (respond to all text)
PREFIXES=.,#,!

# Self Response
# Allow bot to respond to its own messages? true | false
SELF_RESPONSE=true

# Case Insensitive Commands
# Treat commands as case-insensitive? true | false
CASE_INSENSITIVE=true
